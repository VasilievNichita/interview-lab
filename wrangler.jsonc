{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interview-lab",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interview-lab",
      "database_id": "69505164-d3a4-4d53-9cf7-edc07aa00830",
      "migrations_dir": "migrations",
    },
  ],
  // CI intentionally has no AI binding or production database identity.
  "env": {
    "ci": {
      "name": "duskwarden-ci",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "duskwarden-ci",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
